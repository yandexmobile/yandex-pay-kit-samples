platform :ios, '15.0'

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)
require File.expand_path('yandex_pay_sdk_pod_helpers', __dir__)

# macfuse_arc (arcadia FUSE mount) returns ENXIO from File.read when the path
# contains `..`. Flutter's podhelper passes such paths to File.read, so we
# pre-resolve them lexically before delegating. Needed for pod install on CI.
module ArcadiaFusePathFix
  def read(name, *args, **kwargs)
    if name.is_a?(String) && name.include?('..')
      expanded = File.expand_path(name)
      name = expanded if File.exist?(expanded)
    end
    super
  end
end
File.singleton_class.prepend(ArcadiaFusePathFix)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Native iOS SDK (модуль YandexQuickPay). Плагин yandex_pay_quickpay ссылается на него в Swift, но
  # CocoaPods не поддерживает `s.dependency` с :git-источником — поэтому host-app объявляет источник
  # здесь. YandexPayConfiguration подтягивается транзитивно через subspec.
  pod 'YandexPaySDK',
      :git => 'https://github.com/yandexmobile/yandex-pay-ios.git',
      :tag => 'v2.5.3',
      :subspecs => ['YandexQuickPay']

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  # YandexPaySDK 2.5.3 mutates CocoaPods embed scripts at build time, which
  # races parallel Runner builds. Materialize those changes during pod install.
  YandexPaySdkPodHelpers.materialize_runtime_frameworks(installer)

  # YandexPayModularSDK поставляет xcframework'и только под `ios-arm64-simulator` (без x86_64).
  # Xcode в дефолте билдит симулятор как `arm64 + x86_64`, из-за чего [CP] Copy XCFrameworks не
  # находит slice. Исключаем x86_64 для всех таргетов — и Pods, и user project.
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386 x86_64'
    end
  end
  installer.aggregate_targets.each do |aggregate_target|
    aggregate_target.user_project.native_targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['EXCLUDED_ARCHS[sdk=iphonesimulator*]'] = 'i386 x86_64'
      end
    end
    aggregate_target.user_project.save
  end
end
